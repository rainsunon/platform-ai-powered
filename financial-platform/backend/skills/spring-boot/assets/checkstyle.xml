<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  NMN Checkstyle configuration.
  Enforces Google Java Style with project-specific additions.
  Reference: skills/common/code-style.md
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- Require files end with a newline -->
  <module name="NewlineAtEndOfFile"/>

  <!-- No tab characters — 2-space indent enforced by google-java-format -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <!-- Max line length — google-java-format wraps at 100 -->
  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
  </module>

  <module name="TreeWalker">

    <!-- ── Imports ──────────────────────────────────────────────────────── -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalImport">
      <!-- Enforce SLF4J — never java.util.logging or log4j directly -->
      <property name="illegalPkgs" value="java.util.logging, org.apache.log4j, org.apache.logging.log4j"/>
    </module>

    <!-- ── Naming ───────────────────────────────────────────────────────── -->
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="ConstantName"/>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!-- ── Code quality ─────────────────────────────────────────────────── -->
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
      <property name="tokens" value="LITERAL_WHILE,LITERAL_TRY,LITERAL_FINALLY,LITERAL_DO,LITERAL_IF,LITERAL_ELSE,LITERAL_FOR,INSTANCE_INIT,STATIC_INIT,LITERAL_SWITCH,LITERAL_SYNCHRONIZED"/>
    </module>
    <module name="NeedBraces"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>

    <!-- Detect System.out.println — use @Slf4j instead -->
    <module name="Regexp">
      <property name="format" value="System\.(out|err)\.print"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use @Slf4j instead of System.out/err.print — see skills/common/logging.md"/>
    </module>

    <!-- Detect printStackTrace — log the exception via SLF4J instead -->
    <module name="Regexp">
      <property name="format" value="\.printStackTrace\(\)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use log.error(msg, ex) instead of printStackTrace()"/>
    </module>

    <!-- ── Javadoc ──────────────────────────────────────────────────────── -->
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="allowMissingPropertyJavadoc" value="true"/>
      <!-- Only enforce on interfaces — skip implementations annotated @Override -->
      <property name="tokens" value="METHOD_DEF"/>
    </module>

    <!-- ── Whitespace ───────────────────────────────────────────────────── -->
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors" value="true"/>
      <property name="allowEmptyMethods" value="true"/>
      <property name="allowEmptyTypes" value="true"/>
      <property name="allowEmptyLoops" value="true"/>
    </module>
    <module name="GenericWhitespace"/>
    <module name="NoWhitespaceBefore"/>
    <module name="NoWhitespaceAfter"/>

    <!-- ── Miscellaneous ────────────────────────────────────────────────── -->
    <module name="UpperEll"/>           <!-- use L not l for long literals -->
    <module name="ArrayTypeStyle"/>     <!-- String[] args, not String args[] -->
    <module name="FallThrough"/>        <!-- no fall-through in switch without comment -->
    <module name="ModifierOrder"/>

  </module>
</module>
