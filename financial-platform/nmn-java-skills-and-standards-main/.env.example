# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env for local development, never commit .env
# All variables here are required unless marked OPTIONAL.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myservice
DB_USERNAME=myservice
DB_PASSWORD=change-me-locally

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 characters, randomly generated — never reuse across environments
JWT_SECRET=change-me-to-a-random-32-char-minimum-secret
JWT_EXPIRATION_MS=900000       # 15 minutes
JWT_REFRESH_MS=604800000       # 7 days

# ── Application server ────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ── Kafka (OPTIONAL — remove if not using Kafka) ──────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=myservice-consumer-group

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Observability (OPTIONAL — needed for production tracing) ──────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLING_PROBABILITY=1.0   # 100% in local; use 0.1 in production

# ── OWASP Dependency Check (OPTIONAL — speeds up NVD feed download in CI) ────
NVD_API_KEY=

# ── Nexus / Artifactory (OPTIONAL — needed only for internal artifact access) ─
NEXUS_USERNAME=
NEXUS_PASSWORD=

# ── Swagger UI (OPTIONAL) ─────────────────────────────────────────────────────
SWAGGER_ENABLED=true   # true in local/dev; false in production

# ── Version metadata (injected by CI/CD pipeline) ────────────────────────────
APP_VERSION=dev
APP_COMMIT=local
APP_BUILD_DATE=local
